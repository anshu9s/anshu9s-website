rules_version = '2';

// Paste this whole file into Firebase console -> Firestore Database -> Rules -> Publish.
//
// What these rules guarantee (enforced by Google's servers, not by the page):
//  - Anyone can READ messages. Nobody needs an account to look around.
//  - A username can be claimed ONCE, by one account, and never changed or deleted.
//  - One account can own only ONE username.
//  - A message can only be posted by an account that owns a username,
//    and it always carries that account's real username (no pretending to be someone else).
//  - Messages can't be edited or deleted by visitors.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    // usernames/{lowercase name} -> who owns it
    match /usernames/{name} {

      // Allow looking up one name ("is it free?") but not listing everyone.
      allow get: if true;
      allow list: if false;

      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9_.]{1,18}[a-z0-9]$')
        && !(name in ['admin', 'mod', 'moderator', 'system', 'owner', 'support', 'staff'])
        && request.resource.data.keys().hasOnly(['uid', 'display', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.display is string
        && request.resource.data.display.lower() == name
        && request.resource.data.createdAt == request.time
        && !exists(userDoc(request.auth.uid));

      allow update, delete: if false;
    }

    // users/{uid} -> the one username that account owns (private to that account)
    match /users/{uid} {

      allow read: if signedIn() && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username', 'display', 'createdAt'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.display is string
        && request.resource.data.display.lower() == request.resource.data.username
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.display == request.resource.data.display;

      allow update, delete: if false;
    }

    match /messages/{id} {

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'ts'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && request.resource.data.ts == request.time
        && request.resource.data.name == get(userDoc(request.auth.uid)).data.display;

      allow update, delete: if false;
    }
  }
}
